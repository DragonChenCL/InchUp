# Docker 部署配置。deploy.sh 首次运行会复制为 .env.production。
APP_URL=https://inchup.serunio.com

# 默认只允许同一宿主机上的反向代理访问。
BIND_ADDRESS=127.0.0.1
DEPLOY_PORT=5173

# 请在 LINUX DO Connect 中申请应用，并填写应用凭证。
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=https://inchup.serunio.com/auth/linuxdo/callback

# 真实部署关闭共用体验账号。
ENABLE_DEMO=false

# 选填。多个模型服务 origin 用逗号分隔，设置后替换默认名单。
LLM_ALLOWED_ORIGINS=
