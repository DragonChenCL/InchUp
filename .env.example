# 复制为 .env 后填写。默认仅监听本机，适合开发与体验。
HOST=127.0.0.1
PORT=5173
APP_URL=http://localhost:5173
DATABASE_PATH=./data/inchup.sqlite

# 在 https://connect.linux.do 申请应用，回调地址与下方保持一致。
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=http://localhost:5173/auth/linuxdo/callback

# 开放本地体验账号。部署给真实用户时设为 false，并使用 HTTPS。
ENABLE_DEMO=true

# 可选：限制用户能连接的模型服务地址，以逗号分隔完整 origin。
# 未设置时仅允许公网 HTTPS；本地 HTTP 服务须明确加入白名单。
LLM_ALLOWED_ORIGINS=
